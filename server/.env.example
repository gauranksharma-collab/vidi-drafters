PORT=5050
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Use your own database name so data
# never mixes with another project on the same cluster.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vidhik-drafters

# SMTP - used for registration/contact-form notification emails and
# password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# Draft app payment: leave both blank to run in "manual payment" mode
# (order is placed with paymentStatus=pending, an admin marks it paid once
# funds are confirmed). Fill these in with real Razorpay keys to enable
# actual online payment at checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Legacy site's payment gateway was actually Cashfree, not Razorpay - and
# only ever this sandbox pair (test.cashfree.com), so there's no real
# payment credential to recover here. Not read by any code in this repo
# (checkoutController.js was built against Razorpay's API, not Cashfree's);
# kept only as a documented reference. See server/.env for the actual values.
CASHFREE_TEST_APP_ID=
CASHFREE_TEST_SECRET_KEY=

# Fast2SMS - sends the mobile-number OTP during registration. Get the API
# key from https://www.fast2sms.com/dashboard/dev-api (the legacy site used
# this same provider with sender_id TXTIND; reuse that account's key here
# if the DLT sender ID is still approved on it). Leave FAST2SMS_SENDER_ID
# unset to default to TXTIND.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# One-time migration only (legacy MySQL) - not needed for normal operation.
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=
